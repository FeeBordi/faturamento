function desenharKpis(){
  var dados = filtrados();
  var tIda=0, tVolta=0, qIda=0, qVolta=0, vistos={};
  dados.forEach(function(f){
    var v = Number(f[COL.total])||0;
    if (f[COL.tipo] === 'IDA') { tIda += v; qIda++; } else { tVolta += v; qVolta++; }
    vistos[clienteDo(f)] = true;
  });
  var total = tIda + tVolta, qtd = dados.length;

  document.getElementById('kpiTotal').textContent = brl(total);
  document.getElementById('kpiTotalSub').textContent =
    Object.keys(vistos).length + ' clientes · ' + qtd.toLocaleString('pt-BR') + ' fretes';
  document.getElementById('kpiIda').textContent = brl(tIda);
  document.getElementById('kpiIdaSub').textContent = qIda.toLocaleString('pt-BR')+' fretes · '+pct(tIda,total)+' do total';
  document.getElementById('kpiVolta').textContent = brl(tVolta);
  document.getElementById('kpiVoltaSub').textContent = qVolta.toLocaleString('pt-BR')+' fretes · '+pct(tVolta,total)+' do total';
  document.getElementById('kpiTicket').textContent = qtd ? brl(total/qtd) : brl(0);

  var melhor = null;
  agrupar(dados).forEach(function(g){ if (!melhor || g.total > melhor.total) melhor = g; });
  document.getElementById('kpiTicketSub').textContent =
    melhor ? ('Melhor período: ' + melhor.rotulo + ', ' + brl(melhor.total)) : 'Sem fretes no filtro';
}

function agrupar(dados){
  var mapa = {};
  dados.forEach(function(f){
    var p = partes(f[COL.programacao]);
    if (!p) return;
    var g = chaveGrupo(p);
    if (!mapa[g.chave]) mapa[g.chave] = {chave:g.chave, rotulo:g.rotulo, ida:0, volta:0, total:0, qtd:0};
    var v = Number(f[COL.total])||0;
    if (f[COL.tipo] === 'IDA') mapa[g.chave].ida += v; else mapa[g.chave].volta += v;
    mapa[g.chave].total += v;
    mapa[g.chave].qtd++;
  });
  return Object.keys(mapa).sort().map(function(k){ return mapa[k]; });
}

function desenharGrafico(){
  var alvo = document.getElementById('grafico');
  var grupos = agrupar(filtrados());
  var nomes = {dia:'dia', semana:'semana', mes:'mês', ano:'ano'};
  document.getElementById('tituloGrafico').textContent = 'Faturamento por ' + nomes[estado.filtros.agrupar];

  if (!grupos.length) {
    alvo.innerHTML = '<div class="vazio" style="margin:auto">Nenhum frete no filtro escolhido.</div>';
    document.getElementById('legendaGrafico').textContent = '';
    return;
  }

  var mostrar = grupos.slice(-60), maior = 0;
  mostrar.forEach(function(g){ if (g.total > maior) maior = g.total; });
  if (maior <= 0) maior = 1;

  alvo.innerHTML = mostrar.map(function(g){
    var hi = Math.round((g.ida/maior)*150), hv = Math.round((g.volta/maior)*150);
    return '<div class="col" title="'+escapar(g.rotulo)+' — '+brl(g.total)+' em '+g.qtd+' fretes">' +
             '<div class="cif">'+curto(g.total)+'</div>' +
             '<div class="pil i" style="height:'+hi+'px"></div>' +
             '<div class="pil v" style="height:'+hv+'px"></div>' +
             '<div class="rotulo">'+escapar(g.rotulo)+'</div>' +
           '</div>';
  }).join('');

  document.getElementById('legendaGrafico').textContent =
    mostrar.length + ' períodos' + (grupos.length > mostrar.length ? ' (os últimos)' : '');
}

function porCliente(dados){
  var mapa = {};
  dados.forEach(function(f){
    var c = clienteDo(f);
    if (!mapa[c]) mapa[c] = {cliente:c, ida:0, volta:0, total:0, qIda:0, qVolta:0, qtd:0};
    var v = Number(f[COL.total])||0;
    if (f[COL.tipo] === 'IDA') { mapa[c].ida += v; mapa[c].qIda++; }
    else                       { mapa[c].volta += v; mapa[c].qVolta++; }
    mapa[c].total += v;
    mapa[c].qtd++;
  });
  return Object.keys(mapa).map(function(k){ return mapa[k]; }).sort(function(a,b){ return b.total - a.total; });
}

