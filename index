      var celulas = COLUNAS_LISTA.map(function(c){
        var v = valorDe(f, c.campo);

        if (c.campo === 'tipo') {
          return '<td><span class="tag ' + (ida ? 'i' : 'v') + '">' + (ida ? 'IDA' : 'RET') + '</span></td>';
        }
        if (c.campo === 'total') {
          return '<td class="v">' + (pendente ? '<span class="tag p">SEM VALOR</span>'
                                              : '<b>' + numero(v) + '</b>') + '</td>';
        }
        if (c.dir) return '<td class="v">' + numero(v) + '</td>';
        if (c.campo === 'notas') return '<td>' + escapar(String(v).slice(0, 28)) + '</td>';
        if (c.campo === 'clienteDestino' || c.campo === 'alteradoPor') {
          return '<td' + (v ? '' : ' class="fraco"') + '>' + escapar(v || '—') + '</td>';
        }
        var classe = (c.ordem === 'data' || c.campo === 'id' || c.campo === 'ctrc' ||
                      c.campo === 'cavalo' || c.campo === 'carreta' || c.campo === 'envelope') ? ' class="num"' : '';
        return '<td' + classe + '>' + escapar(v) + '</td>';
      }).join('');

      var acoes = master
        ? '<button class="btn claro mini" data-editar="' + escapar(f[COL.id]) + '">Editar</button> ' +
          '<button class="btn perigo mini" data-excluir="' + escapar(f[COL.id]) + '">Excluir</button>'
        : '<span class="fraco">somente leitura</span>';

      return '<tr>' + celulas + '<td>' + acoes + '</td></tr>';
    }).join('');
  }

  var soma = dados.reduce(function(s,f){ return s + (Number(f[COL.total])||0); }, 0);
  var semValor = dados.filter(function(f){ return (Number(f[COL.total])||0) <= 0; }).length;
  document.getElementById('infoFretes').textContent =
    dados.length.toLocaleString('pt-BR') + ' fretes · ' + brl(soma) +
    (semValor ? ' · ' + semValor + ' sem valor' : '') +
    (dados.length > mostrar.length ? ' · mostrando os ' + mostrar.length + ' primeiros' : '');
}

function montarSugestoes(){
  /* Só placas e motoristas continuam com sugestão.
     Cliente e cidade são digitados livres, a pedido. */
  var mapas = { lista_cavalos:COL.cavalo, lista_carretas:COL.carreta, lista_motoristas:COL.motorista };
  Object.keys(mapas).forEach(function(idLista){
    var col = mapas[idLista], vistos = {};
    estado.fretes.forEach(function(f){ if (f[col]) vistos[f[col]] = true; });
    var el = document.getElementById(idLista);
    if (!el) return;
    el.innerHTML = Object.keys(vistos).sort().map(function(v){
      return '<option value="'+escapar(v)+'"></option>';
    }).join('');
  });
}

/* ===================== FORMULÁRIO ===================== */
function totalForm(){
  var soma = ['f_frete','f_pedagio','f_advalorem','f_despesas','f_icms'].reduce(function(s,id){
    return s + paraNumero(document.getElementById(id).value);
  }, 0);
  document.getElementById('f_total').textContent = brl(soma);
  return Math.round(soma*100)/100;
}

function limparForm(){
  document.getElementById('formFrete').reset();
  document.getElementById('f_id').value = '';
  estado.editando = null;
  document.getElementById('tituloForm').textContent = 'Lançar novo frete';
  document.getElementById('btnSalvar').textContent = 'Gravar frete na planilha';
  document.getElementById('btnCancelarEdicao').style.display = 'none';
  ['msg_clienteOrigem','msg_programacao','msg_agenda'].forEach(function(id){
    var el = document.getElementById(id); if (el) el.textContent = '';
  });
  document.querySelectorAll('#formFrete input').forEach(function(i){ i.classList.remove('ruim'); });
  totalForm();
}

function validarForm(){
  var problemas = [];
  var origem = document.getElementById('f_clienteOrigem');
  var prog   = document.getElementById('f_programacao');
  var agenda = document.getElementById('f_agenda');

  [origem, prog, agenda].forEach(function(i){ i.classList.remove('ruim'); });
  document.getElementById('msg_clienteOrigem').textContent = '';
  document.getElementById('msg_programacao').textContent = '';
  document.getElementById('msg_agenda').textContent = '';

  if (!origem.value.trim()) {
    document.getElementById('msg_clienteOrigem').textContent = 'Informe o cliente de origem.';
    origem.classList.add('ruim');
    problemas.push('cliente de origem');
  }
  if (!prog.value) {
    document.getElementById('msg_programacao').textContent = 'Informe a data de carregamento.';
    prog.classList.add('ruim');
    problemas.push('programação');
  }
  if (agenda.value && prog.value && agenda.value < prog.value) {
    document.getElementById('msg_agenda').textContent = 'A entrega não pode ser antes do carregamento.';
    agenda.classList.add('ruim');
    problemas.push('agenda');
  }
  /* Valor zerado é permitido de propósito: primeiro entra a programação,
     os valores entram depois pelo botão Editar. */
  return problemas;
}

function lerForm(){
  return {
    id:             document.getElementById('f_id').value.trim(),
    tipo:           document.getElementById('f_tipo').value,
    programacao:    isoParaBR(document.getElementById('f_programacao').value),
    clienteOrigem:  document.getElementById('f_clienteOrigem').value.trim().toUpperCase(),
    clienteDestino: document.getElementById('f_clienteDestino').value.trim().toUpperCase(),
    senhas:         document.getElementById('f_senhas').value.trim(),
    origem:         document.getElementById('f_origem').value.trim().toUpperCase(),
    destino:        document.getElementById('f_destino').value.trim().toUpperCase(),
    ctrc:           document.getElementById('f_ctrc').value.trim(),
    notas:          document.getElementById('f_notas').value.trim(),
    frete:          paraNumero(document.getElementById('f_frete').value),
    pedagio:        paraNumero(document.getElementById('f_pedagio').value),
    advalorem:      paraNumero(document.getElementById('f_advalorem').value),
    despesas:       paraNumero(document.getElementById('f_despesas').value),
    icms:           paraNumero(document.getElementById('f_icms').value),
    total:          totalForm(),
    cavalo:         document.getElementById('f_cavalo').value.trim().toUpperCase(),
    carreta:        document.getElementById('f_carreta').value.trim().toUpperCase(),
    motorista:      document.getElementById('f_motorista').value.trim().toUpperCase(),
    agenda:         isoParaBR(document.getElementById('f_agenda').value),
    envelope:       document.getElementById('f_envelope').value.trim()
  };
}

function preencherForm(f){
  document.getElementById('f_id').value             = f[COL.id];
  document.getElementById('f_tipo').value           = f[COL.tipo] === 'IDA' ? 'IDA' : 'RETORNO';
  document.getElementById('f_programacao').value    = dataParaISO(f[COL.programacao]);
  document.getElementById('f_clienteOrigem').value  = f[COL.clienteOrigem];
  document.getElementById('f_clienteDestino').value = f[COL.clienteDestino];
  document.getElementById('f_senhas').value         = f[COL.senhas];
  document.getElementById('f_origem').value         = f[COL.origem];
  document.getElementById('f_destino').value        = f[COL.destino];
  document.getElementById('f_ctrc').value           = f[COL.ctrc];
  document.getElementById('f_notas').value          = f[COL.notas];
  document.getElementById('f_frete').value          = numero(f[COL.frete]);
  document.getElementById('f_pedagio').value        = numero(f[COL.pedagio]);
  document.getElementById('f_advalorem').value      = numero(f[COL.advalorem]);
  document.getElementById('f_despesas').value       = numero(f[COL.despesas]);
  document.getElementById('f_icms').value           = numero(f[COL.icms]);
  document.getElementById('f_cavalo').value         = f[COL.cavalo];
  document.getElementById('f_carreta').value        = f[COL.carreta];
  document.getElementById('f_motorista').value      = f[COL.motorista];
  document.getElementById('f_agenda').value         = dataParaISO(f[COL.agenda]);
  document.getElementById('f_envelope').value       = f[COL.envelope];

  estado.editando = f[COL.id];
  document.getElementById('tituloForm').textContent = 'Editando o frete ' + f[COL.id];
  document.getElementById('btnSalvar').textContent = 'Salvar alterações';
  document.getElementById('btnCancelarEdicao').style.display = '';
  var semValor = totalForm() <= 0;
  trocarAba('lancar');
  window.scrollTo({top:0, behavior:'smooth'});
  if (semValor) {
    var campo = document.getElementById('f_frete');
    window.setTimeout(function(){ campo.focus(); campo.select(); }, 350);
  }
}

/* ===================== CSV ===================== */
function baixarCsv(){
  try {
    var cab = ['ID','TIPO','PROGRAMACAO','CLIENTE ORIGEM','CLIENTE DESTINO','CIDADE ORIGEM','CIDADE DESTINO',
               'CTRC','NOTAS FISCAIS','SENHAS','FRETE','PEDAGIO','AD-VALOREM','DESPESAS','ICMS','TOTAL',
               'CAVALO','CARRETA','MOTORISTA','AGENDA','ENVELOPE'];
    var ordem = [COL.id,COL.tipo,COL.programacao,COL.clienteOrigem,COL.clienteDestino,COL.origem,COL.destino,
                 COL.ctrc,COL.notas,COL.senhas,COL.frete,COL.pedagio,COL.advalorem,COL.despesas,COL.icms,
                 COL.total,COL.cavalo,COL.carreta,COL.motorista,COL.agenda,COL.envelope];
    var numericas = [COL.frete,COL.pedagio,COL.advalorem,COL.despesas,COL.icms,COL.total];

    var linhas = [cab.join(';')];
    estado.fretes.forEach(function(f){
      linhas.push(ordem.map(function(i){
        var v = numericas.indexOf(i) > -1 ? numero(f[i]) : f[i];
        return '"' + String(v === undefined || v === null ? '' : v).replace(/"/g,'""') + '"';
      }).join(';'));
    });

    var blob = new Blob(['\ufeff' + linhas.join('\r\n')], {type:'text/csv;charset=utf-8'});
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'faturamento_transccema_' + new Date().toISOString().slice(0,10) + '.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(a.href);
  } catch(err) {
    erro('Não foi possível gerar o CSV: ' + err.message, 'Falha ao exportar');
  }
}

/* ===================== NAVEGAÇÃO ===================== */
function trocarAba(nome){
  if (nome === 'lancar' && estado.perfil !== 'master') return;
  document.querySelectorAll('nav button').forEach(function(b){
    b.setAttribute('aria-selected', String(b.dataset.aba === nome));
  });
  document.querySelectorAll('.aba').forEach(function(s){
    s.classList.toggle('ativa', s.id === 'aba-' + nome);
  });
}

