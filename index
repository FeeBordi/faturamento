<script>
(function(){
'use strict';

/* ===================== COLUNAS ===================== */
/* URL do Apps Script já configurada. Só troque aqui se publicar outra implantação. */
var URL_PADRAO = 'https://script.google.com/macros/s/AKfycbyc1hFTLmV6KG-B2zNj5CYV59sSpvG6p5AOANBtNuvWpPCsB-NNNowaTIUkED26c3VKlw/exec';

var COL = {id:0,tipo:1,programacao:2,clienteOrigem:3,clienteDestino:4,senhas:5,origem:6,destino:7,
           ctrc:8,notas:9,frete:10,pedagio:11,advalorem:12,despesas:13,icms:14,total:15,
           cavalo:16,carreta:17,motorista:18,agenda:19,envelope:20,atualizado:21,alteradoPor:22};

var estado = {
  url:'', token:'', perfil:'', nome:'',
  fretes:[], carregando:false, relogio:null,
  filtros:{ base:'origem', ano:'todos', mes:'todos', agrupar:'mes', tipo:'todos', cliente:'todos' },
  lista:{ tipo:'todos', mes:'todos', busca:'', pendentes:false,
           filtros:{}, ordemCampo:'programacao', ordemDesc:true },
  editando:null
};

var MESES = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
var memoria = {};
var SEM_CLIENTE = '(não informado)';

/* ===================== ARMAZENAMENTO ===================== */
function guardar(chave, valor){
  try { window.localStorage.setItem(chave, valor); } catch(err){ memoria[chave] = valor; }
}
function ler(chave){
  try { var v = window.localStorage.getItem(chave); return (v === null) ? (memoria[chave] || '') : v; }
  catch(err){ return memoria[chave] || ''; }
}
function apagar(chave){
  try { window.localStorage.removeItem(chave); } catch(err){ delete memoria[chave]; }
}

/* ===================== FORMATAÇÃO ===================== */
function brl(n){
  return 'R$ ' + (Number(n)||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
}
function curto(n){
  var v = Number(n)||0;
  if (Math.abs(v) >= 1000000) return (v/1000000).toLocaleString('pt-BR',{maximumFractionDigits:2}) + ' mi';
  if (Math.abs(v) >= 1000)    return (v/1000).toLocaleString('pt-BR',{maximumFractionDigits:0}) + ' mil';
  return v.toLocaleString('pt-BR',{maximumFractionDigits:0});
}
function numero(n){ return (Number(n)||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}); }
function pct(parte, todo){ return todo > 0 ? ((parte/todo)*100).toLocaleString('pt-BR',{maximumFractionDigits:1})+'%' : '0%'; }

function paraNumero(texto){
  if (texto === null || texto === undefined || texto === '') return 0;
  if (typeof texto === 'number') return isNaN(texto) ? 0 : texto;
  var t = String(texto).replace(/[R$\s]/g,'');
  if (t.indexOf(',') > -1) t = t.replace(/\./g,'').replace(',','.');
  var n = parseFloat(t);
  return isNaN(n) ? 0 : n;
}
function dataParaISO(br){
  var m = String(br||'').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  return m ? (m[3]+'-'+m[2]+'-'+m[1]) : '';
}
function isoParaBR(iso){
  var m = String(iso||'').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  return m ? (m[3]+'/'+m[2]+'/'+m[1]) : '';
}
function partes(br){
  var m = String(br||'').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
  if (!m) return null;
  return { dia:+m[1], mes:+m[2], ano:+m[3], iso:m[3]+'-'+m[2]+'-'+m[1] };
}
function escapar(t){
  return String(t === null || t === undefined ? '' : t)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function colunaBase(){
  return estado.filtros.base === 'destino' ? COL.clienteDestino : COL.clienteOrigem;
}
function clienteDo(f){
  var v = f[colunaBase()];
  return (v && String(v).trim()) ? String(v).trim() : SEM_CLIENTE;
}

/* ===================== AVISOS ===================== */
function status(texto, tipo){
  document.getElementById('bolinha').className = 'bolinha ' + (tipo||'');
  document.getElementById('txtStatus').textContent = texto;
}
function erro(mensagem, titulo){
  document.getElementById('tituloErro').textContent = titulo || 'Não foi possível concluir';
  document.getElementById('msgErro').textContent = ' ' + mensagem;
  document.getElementById('bannerErro').classList.add('ver');
}
function limparErro(){ document.getElementById('bannerErro').classList.remove('ver'); }
function sucesso(mensagem){
  document.getElementById('msgOk').textContent = mensagem;
  var el = document.getElementById('bannerOk');
  el.classList.add('ver');
  window.setTimeout(function(){ el.classList.remove('ver'); }, 5000);
}
function agora(){
  var d = new Date();
  return ('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);
}

/* ===================== COMUNICAÇÃO ===================== */
function comTempo(promessa, segundos, oQue){
  var controle = new AbortController(), estourou = false;
  var relogio = window.setTimeout(function(){ estourou = true; controle.abort(); }, segundos*1000);
  return promessa(controle.signal)
    .then(function(r){ window.clearTimeout(relogio); return r; })
    .catch(function(err){
      window.clearTimeout(relogio);
      if (estourou) throw new Error(oQue + ' passou de ' + segundos + ' segundos e foi cancelado.');
      throw err;
    });
}

function lerJson(resposta, contexto){
  if (!resposta.ok) throw new Error('O Google respondeu com erro ' + resposta.status + '.');
  return resposta.text().then(function(texto){
    var dados;
    try { dados = JSON.parse(texto); }
    catch(err){
      throw new Error(contexto + ' A resposta não veio em JSON — confira se a implantação está com acesso para "Qualquer pessoa".');
    }
    return dados;
  });
}

function montarQuery(params){
  var q = [];
  Object.keys(params).forEach(function(k){
    var v = params[k];
    if (v === undefined || v === null || v === '') return;
    q.push(encodeURIComponent(k) + '=' + encodeURIComponent(v));
  });
  q.push('t=' + Date.now());
  return q.join('&');
}

/* Caminho alternativo: carrega a resposta como script.
   Usado quando o navegador bloqueia a chamada direta. */
function porScript(params, segundos){
  return new Promise(function(resolve, reject){
    var nome = 'retorno_' + Date.now() + '_' + Math.floor(Math.random()*100000);
    var script = document.createElement('script');
    var pronto = false;

    var relogio = window.setTimeout(function(){
      if (pronto) return;
      limpar();
      reject(new Error('A planilha não respondeu em ' + segundos + ' segundos.'));
    }, segundos*1000);

    function limpar(){
      pronto = true;
      window.clearTimeout(relogio);
      try { delete window[nome]; } catch(err){ window[nome] = undefined; }
      if (script.parentNode) script.parentNode.removeChild(script);
    }

    window[nome] = function(dados){ limpar(); resolve(dados); };
    script.onerror = function(){
      if (pronto) return;
      limpar();
      reject(new Error('Não foi possível alcançar a planilha. Confira se a implantação está com acesso para "Qualquer pessoa".'));
    };

    var copia = {};
    Object.keys(params).forEach(function(k){ copia[k] = params[k]; });
    copia.callback = nome;

    script.src = estado.url + '?' + montarQuery(copia);
    document.body.appendChild(script);
  });
}

/* Chamada única do sistema. Tenta o caminho normal; se o navegador
   bloquear, refaz pelo caminho alternativo sem incomodar o usuário. */
function chamar(params, oQue, segundos){
  if (!estado.url) return Promise.reject(new Error('Nenhuma URL do Apps Script configurada.'));
  segundos = segundos || 60;

  var leitura = (params.acao === 'listar' || params.acao === 'ping');
  var tentativa;

  if (leitura) {
    tentativa = comTempo(function(sinal){
      return window.fetch(estado.url + '?' + montarQuery(params), {method:'GET', signal:sinal, redirect:'follow'});
    }, segundos, oQue).then(function(r){ return lerJson(r, oQue); });
  } else {
    var corpo = {};
    Object.keys(params).forEach(function(k){ corpo[k] = params[k]; });
    if (corpo.dados) {
      try {
        var lido = JSON.parse(corpo.dados);
        if (params.acao === 'incluirLote') corpo.registros = lido; else corpo.registro = lido;
      } catch(err){ /* mantém dados como veio; o servidor sabe ler os dois */ }
    }
    tentativa = comTempo(function(sinal){
      return window.fetch(estado.url, {
        method:'POST', signal:sinal, redirect:'follow',
        headers:{'Content-Type':'text/plain;charset=utf-8'},
        body: JSON.stringify(corpo)
      });
    }, segundos, oQue).then(function(r){ return lerJson(r, oQue); });
  }

  return tentativa
    .catch(function(err){
      /* Bloqueio do navegador, rede caída ou resposta que não veio em JSON:
         vale a pena refazer pelo caminho alternativo antes de desistir. */
      return porScript(params, segundos);
    })
    .then(function(dados){
      if (!dados || typeof dados !== 'object') {
        throw new Error('A planilha respondeu num formato inesperado.');
      }
      if (dados.expirado) { expirouSessao(dados.erro); throw new Error(dados.erro || 'Sessão expirada.'); }
      if (!dados.ok) throw new Error(dados.erro || 'A planilha recusou a operação.');
      return dados;
    });
}

function baixar(forcar){
  if (!estado.url || !estado.token) { status('sem conexão','off'); return Promise.resolve(false); }
  if (estado.carregando) return Promise.resolve(false);

  estado.carregando = true;
  status('carregando…','carregando');

  return chamar({acao:'listar', token:estado.token, forcar: forcar ? '1' : ''}, 'A leitura da planilha', 90)
    .then(function(dados){
      if (!dados.linhas) throw new Error('A resposta veio sem a lista de fretes.');
      estado.fretes = dados.linhas;
      guardarCache(dados.linhas);
      limparErro();
      status(dados.linhas.length.toLocaleString('pt-BR') + ' fretes · ' + agora(), 'on');
      desenharTudo();
      return true;
    })
    .catch(function(err){
      status('falha ao carregar','off');
      erro(err.message + ' Mostrando o último dado salvo neste navegador.', 'Não foi possível ler a planilha');
      return false;
    })
    .then(function(r){ estado.carregando = false; return r; });
}

function guardarCache(linhas){
  try { guardar('faturamento_cache_v2', JSON.stringify({linhas:linhas, em:Date.now()})); } catch(err){}
}
function lerCache(){
  try {
    var t = ler('faturamento_cache_v2');
    if (!t) return null;
    var o = JSON.parse(t);
    return (o && o.linhas) ? o.linhas : null;
  } catch(err){ return null; }
}

/* ===================== LOGIN ===================== */
function mostrarLogin(mensagem){
  document.getElementById('login').classList.remove('escondido');
  document.getElementById('app').classList.add('escondido');
  document.getElementById('avisoLogin').textContent = mensagem || '';
  document.getElementById('l_senha').value = '';
  if (estado.relogio) { window.clearInterval(estado.relogio); estado.relogio = null; }
}

function mostrarApp(){
  document.getElementById('login').classList.add('escondido');
  document.getElementById('app').classList.remove('escondido');
  aplicarPerfil();
  if (!estado.relogio) {
    estado.relogio = window.setInterval(function(){ if (!estado.carregando) baixar(false); }, 120000);
  }
}

function expirouSessao(mensagem){
  estado.token = '';
  apagar('faturamento_token');
  apagar('faturamento_perfil');
  apagar('faturamento_nome');
  mostrarLogin(mensagem || 'Sua sessão expirou. Entre de novo.');
}

function entrar(){
  var u = document.getElementById('l_usuario').value.trim();
  var s = document.getElementById('l_senha').value;
  var aviso = document.getElementById('avisoLogin');
  var botao = document.getElementById('btnEntrar');

  if (!estado.url) {
    aviso.textContent = 'Configure primeiro a conexão com a planilha (link abaixo).';
    return;
  }
  if (!u || !s) { aviso.textContent = 'Informe usuário e senha.'; return; }

  botao.disabled = true;
  botao.textContent = 'Entrando…';
  aviso.textContent = '';

  chamar({acao:'login', usuario:u, senha:s}, 'O login', 45)
    .then(function(dados){
      estado.token  = dados.token;
      estado.perfil = dados.perfil;
      estado.nome   = dados.nome || u;
      guardar('faturamento_token', estado.token);
      guardar('faturamento_perfil', estado.perfil);
      guardar('faturamento_nome', estado.nome);
      mostrarApp();
      if (dados.avisoSenha) {
        erro('As senhas ainda são as de fábrica. Troque no bloco USUARIOS do Apps Script e publique uma nova versão.',
             'Atenção com o acesso');
      }
      return baixar(true);
    })
    .catch(function(err){ aviso.textContent = err.message; })
    .then(function(){
      botao.disabled = false;
      botao.textContent = 'Entrar';
    });
}

function sair(){
  var t = estado.token;
  expirouSessao('Você saiu do sistema.');
  if (t && estado.url) {
    chamar({acao:'sair', token:t}, 'A saída', 20).catch(function(){ /* sair é local de qualquer jeito */ });
  }
}

function aplicarPerfil(){
  var master = estado.perfil === 'master';
  var cracha = document.getElementById('cracha');
  cracha.textContent = (estado.nome || '') + (master ? ' · master' : ' · visualização');
  cracha.className = 'cracha' + (master ? '' : ' somenteler');

  var nav = document.getElementById('navLancar');
  nav.classList.toggle('escondido', !master);
  if (!master) {
    document.querySelectorAll('nav button').forEach(function(b){
      if (b.dataset.aba === 'lancar' && b.getAttribute('aria-selected') === 'true') trocarAba('painel');
    });
  }
}

/* ===================== FILTROS ===================== */
function anosDisponiveis(){
  var s = {};
  estado.fretes.forEach(function(f){
    var p = partes(f[COL.programacao]);
    if (p) s[p.ano] = true;
  });
  return Object.keys(s).sort().reverse();
}

function filtrados(){
  var fl = estado.filtros;
  return estado.fretes.filter(function(f){
    var p = partes(f[COL.programacao]);
    if (!p) return false;
    if (fl.ano  !== 'todos' && String(p.ano) !== String(fl.ano)) return false;
    if (fl.mes  !== 'todos' && String(p.mes) !== String(fl.mes)) return false;
    if (fl.tipo !== 'todos' && f[COL.tipo] !== fl.tipo) return false;
    if (fl.cliente !== 'todos' && clienteDo(f) !== fl.cliente) return false;
    return true;
  });
}

function chaveGrupo(p){
  if (estado.filtros.agrupar === 'dia')
    return { chave:p.iso, rotulo:('0'+p.dia).slice(-2)+'/'+('0'+p.mes).slice(-2) };
  if (estado.filtros.agrupar === 'ano')
    return { chave:String(p.ano), rotulo:String(p.ano) };
  if (estado.filtros.agrupar === 'semana') {
    var d = new Date(p.ano, p.mes-1, p.dia);
    d.setDate(d.getDate() - ((d.getDay()+6)%7));
    var iso = d.getFullYear()+'-'+('0'+(d.getMonth()+1)).slice(-2)+'-'+('0'+d.getDate()).slice(-2);
    return { chave:iso, rotulo:('0'+d.getDate()).slice(-2)+'/'+('0'+(d.getMonth()+1)).slice(-2) };
  }
  return { chave:p.ano+'-'+('0'+p.mes).slice(-2), rotulo:MESES[p.mes-1]+'/'+String(p.ano).slice(-2) };
}

