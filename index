<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TRANSCCEMA — Faturamento por Cliente</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%2310202e'/><text x='16' y='23' font-size='18' font-family='sans-serif' font-weight='bold' fill='%23f2b705' text-anchor='middle'>T</text></svg>">
<style>
  :root{
    --tinta:#10202e; --tinta-2:#3d5566; --papel:#eef1f3; --carta:#fff;
    --linha:#d3dbe1; --ida:#0f766e; --volta:#c2560a; --sinal:#f2b705;
    --erro:#b42318; --ok:#0f766e;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--papel);color:var(--tinta);
    font-family:"Segoe UI",-apple-system,system-ui,Roboto,Arial,sans-serif;font-size:14px;line-height:1.45}
  .num,td.v,th.v,.val{font-variant-numeric:tabular-nums;font-feature-settings:"tnum" 1}
  button{font-family:inherit}

  /* ---------- LOGIN ---------- */
  #login{position:fixed;inset:0;background:linear-gradient(160deg,#10202e 0%,#1d3242 60%,#25455a 100%);
    display:flex;align-items:center;justify-content:center;padding:20px;z-index:80}
  #login.escondido{display:none}
  .cartao{background:#fff;border-radius:12px;width:100%;max-width:380px;padding:28px;
    box-shadow:0 20px 50px rgba(0,0,0,.35)}
  .cartao .logo{font-weight:800;letter-spacing:.08em;font-size:19px}
  .cartao .logo em{color:var(--sinal);font-style:normal}
  .cartao .sub{color:var(--tinta-2);font-size:13px;margin:4px 0 22px}
  .cartao label{font-size:11.5px;font-weight:700;color:var(--tinta-2);display:block;margin-bottom:4px}
  .cartao .linha-campo{margin-bottom:14px}
  .cartao input{width:100%;border:1px solid var(--linha);border-radius:7px;padding:10px 12px;font-size:14px;
    font-family:inherit;color:var(--tinta)}
  .cartao input:focus{outline:2px solid var(--sinal);outline-offset:1px;border-color:var(--sinal)}
  .cartao button{width:100%;background:var(--tinta);color:#fff;border:0;border-radius:7px;padding:11px;
    font-size:14px;font-weight:700;cursor:pointer;margin-top:6px}
  .cartao button:hover{background:#1d3242}
  .cartao button:disabled{opacity:.6;cursor:not-allowed}
  .cartao .aviso{font-size:12.5px;color:var(--erro);min-height:18px;margin-top:10px}
  .cartao .rodape{font-size:11.5px;color:var(--tinta-2);margin-top:16px;border-top:1px solid var(--linha);
    padding-top:12px;line-height:1.6}
  .cartao .rodape a{color:var(--tinta);cursor:pointer;text-decoration:underline}

  /* ---------- APP ---------- */
  #app.escondido{display:none}
  header{background:var(--tinta);color:#fff;padding:12px 20px;position:sticky;top:0;z-index:40;
    display:flex;align-items:center;gap:16px;flex-wrap:wrap;box-shadow:0 2px 10px rgba(16,32,46,.25)}
  .marca{font-weight:800;letter-spacing:.06em;font-size:15px}
  .marca span{color:#9fb3c1;font-weight:500;letter-spacing:.02em}
  .status{margin-left:auto;display:flex;align-items:center;gap:10px;font-size:12.5px;color:#c3d2dc;flex-wrap:wrap}
  .bolinha{width:9px;height:9px;border-radius:50%;background:#8ba3b2;display:inline-block}
  .bolinha.on{background:#38d39f}.bolinha.off{background:#f2705a}.bolinha.carregando{background:var(--sinal)}
  .cracha{background:#1d3242;border-radius:20px;padding:4px 12px;font-size:12px;color:#dbe6ed}
  .cracha b{color:#fff}
  .cracha.somenteler{background:#4a3a08;color:#ffe9a6}
  .ico{background:#1d3242;border:0;color:#c3d2dc;border-radius:6px;padding:6px 12px;cursor:pointer;font-size:12.5px}
  .ico:hover{background:#294559;color:#fff}

  nav{background:#1d3242;padding:0 20px;display:flex;gap:4px;position:sticky;top:53px;z-index:39;flex-wrap:wrap}
  nav button{background:transparent;border:0;border-bottom:3px solid transparent;color:#a8bcc9;
    padding:11px 18px;font-size:14px;font-weight:600;cursor:pointer}
  nav button[aria-selected="true"]{color:#fff;border-bottom-color:var(--sinal)}
  nav button.escondido{display:none}

  .banner{display:none;padding:11px 20px;font-size:13px;align-items:flex-start;gap:10px}
  .banner.ver{display:flex}
  .banner.ruim{background:#fdecea;color:var(--erro);border-bottom:2px solid var(--erro)}
  .banner.bom{background:#e6f4f1;color:var(--ok);border-bottom:2px solid var(--ok)}
  .banner b{display:block}
  .banner button{margin-left:auto;background:transparent;border:1px solid currentColor;color:inherit;
    border-radius:5px;padding:3px 10px;cursor:pointer;font-size:12px;white-space:nowrap}

  main{padding:20px;max-width:1240px;margin:0 auto}
  .aba{display:none}.aba.ativa{display:block}
  .tela{background:var(--carta);border:1px solid var(--linha);border-radius:10px;overflow:hidden;margin-bottom:18px}
  .cab{padding:14px 20px;border-bottom:1px solid var(--linha);display:flex;justify-content:space-between;
    align-items:center;gap:12px;flex-wrap:wrap}
  .cab h2{margin:0;font-size:16px}
  .cab .info{font-size:12.5px;color:var(--tinta-2)}

  .chips{display:flex;gap:6px;flex-wrap:wrap;padding:12px 20px;border-bottom:1px solid var(--linha);
    background:#f7f9fa;align-items:center}
  .chip{border:1px solid var(--linha);background:#fff;border-radius:20px;padding:5px 13px;font-size:12.5px;
    cursor:pointer;color:var(--tinta-2)}
  .chip:hover{border-color:var(--tinta-2)}
  .chip.on{background:var(--tinta);border-color:var(--tinta);color:#fff;font-weight:600}
  .sep{width:1px;height:22px;background:var(--linha);margin:0 6px}
  .rot{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--tinta-2);font-weight:700}
  select,input,textarea{font-family:inherit;font-size:13.5px;border:1px solid var(--linha);border-radius:6px;
    padding:7px 9px;background:#fff;color:var(--tinta);width:100%}
  select:focus,input:focus{outline:2px solid var(--sinal);outline-offset:1px;border-color:var(--sinal)}
  .chips select{width:auto;min-width:150px;padding:5px 8px;border-radius:20px}

  .btn{background:var(--tinta);color:#fff;border:0;border-radius:6px;padding:8px 16px;font-size:13px;
    font-weight:600;cursor:pointer}
  .btn:hover{background:#1d3242}
  .btn:disabled{opacity:.5;cursor:not-allowed}
  .btn.claro{background:#fff;color:var(--tinta);border:1px solid var(--linha)}
  .btn.claro:hover{background:#f2f5f7}
  .btn.perigo{background:#fff;color:var(--erro);border:1px solid #f0c2bd}
  .btn.perigo:hover{background:#fdecea}
  .btn.mini{padding:4px 9px;font-size:12px}

  .kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--linha)}
  .kpi{background:#fff;padding:16px 18px}
  .kpi .lab{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--tinta-2);font-weight:700}
  .kpi .val{font-size:26px;font-weight:800;letter-spacing:-.02em;margin-top:4px}
  .kpi .sub{font-size:12px;color:var(--tinta-2);margin-top:2px}

  .grid2{display:grid;grid-template-columns:1.1fr .9fr;gap:1px;background:var(--linha);border-top:1px solid var(--linha)}
  .bloco{background:#fff;padding:16px 20px}
  .bloco h3{margin:0 0 14px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--tinta-2)}
  .barras{display:flex;align-items:flex-end;gap:6px;height:210px;overflow-x:auto;padding-top:4px}
  .col{flex:1;min-width:26px;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;cursor:pointer}
  .col:hover .pil{filter:brightness(1.15)}
  .col .pil{width:100%;border-radius:2px 2px 0 0}
  .col .pil.i{background:var(--ida)}
  .col .pil.v{background:var(--volta)}
  .col .rotulo{font-size:10.5px;color:var(--tinta-2);margin-top:6px;font-weight:600;white-space:nowrap}
  .col .cif{font-size:10px;color:var(--tinta-2);margin-bottom:3px;white-space:nowrap}
  .legenda{display:flex;gap:16px;font-size:12px;color:var(--tinta-2);margin-top:12px;flex-wrap:wrap}
  .pt{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px}

  .rank{display:flex;flex-direction:column;gap:8px;max-height:250px;overflow:auto}
  .rk{display:grid;grid-template-columns:130px 1fr 96px;align-items:center;gap:10px;font-size:12.5px;
    cursor:pointer;padding:2px 0}
  .rk:hover .nome{text-decoration:underline}
  .rk .nome{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .trilho{background:#eef1f3;height:15px;border-radius:3px;overflow:hidden;display:flex}
  .trilho i{display:block;height:100%}
  .trilho i.i{background:var(--ida)}
  .trilho i.v{background:var(--volta)}
  .rk .cif{text-align:right;font-weight:700;font-variant-numeric:tabular-nums}

  .rolagem{overflow-x:auto}
  table{width:100%;border-collapse:collapse}
  th,td{text-align:left;padding:8px 10px;border-bottom:1px solid #e7ecef;font-size:13px;white-space:nowrap}
  th{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--tinta-2);background:#f7f9fa;
    font-weight:700;position:sticky;top:0;z-index:1}
  td.v,th.v{text-align:right}
  tbody tr:hover{background:#f7fafb}
  tr.total td{background:#f0f4f6;font-weight:800;border-top:2px solid var(--tinta)}
  .tag{font-size:10.5px;font-weight:700;padding:2px 7px;border-radius:4px;letter-spacing:.04em}
  .tag.i{background:#d7f0ec;color:var(--ida)}
  .tag.v{background:#fbe4d2;color:var(--volta)}
  .tag.p{background:#fdf0cd;color:#8a6400}
  th.ordenavel{cursor:pointer;user-select:none}
  th.ordenavel:hover{color:var(--tinta)}
  th .seta{color:var(--sinal);font-size:10px;margin-left:3px}
  tr.filtros th{background:#fbfcfd;padding:4px 6px;position:sticky;top:29px;z-index:1;border-bottom:2px solid var(--linha)}
  tr.filtros select,tr.filtros input{width:100%;min-width:88px;padding:3px 5px;font-size:11.5px;
    border-radius:4px;border:1px solid var(--linha)}
  tr.filtros select.ativo,tr.filtros input.ativo{border-color:var(--sinal);background:#fffdf3;font-weight:700}
  .limpar-filtros{background:none;border:1px solid var(--linha);border-radius:4px;font-size:11px;
    padding:3px 8px;cursor:pointer;color:var(--tinta-2);white-space:nowrap}
  .limpar-filtros:hover{border-color:var(--tinta-2);color:var(--tinta)}
  .aviso-pendente{padding:10px 20px;background:#fdf6e3;border-top:1px solid var(--linha);
    font-size:13px;color:#7a5c00;cursor:pointer}
  .aviso-pendente:hover{background:#fbeecb}
  .aviso-pendente b{font-weight:800}
  .fraco{color:#8ba3b2}
  .vazio{padding:34px 20px;text-align:center;color:var(--tinta-2);font-size:13.5px}

  form .secao{padding:16px 20px;border-bottom:1px solid var(--linha)}
  form .secao h3{margin:0 0 14px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--tinta-2)}
  .campos{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  .campo{display:flex;flex-direction:column;gap:4px}
  .campo.largo{grid-column:span 2}
  .campo.total{grid-column:span 4}
  .campo label{font-size:11.5px;font-weight:700;color:var(--tinta-2)}
  .campo .dica{font-size:11px;color:var(--tinta-2);font-weight:400}
  .campo .msg{font-size:11.5px;color:var(--erro);min-height:14px}
  .campo input.ruim{border-color:var(--erro);background:#fffafa}
  .somatorio{background:#f7f9fa;border:1px solid var(--linha);border-radius:8px;padding:14px 18px;
    display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}
  .somatorio .lab{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--tinta-2);font-weight:700}
  .somatorio .val{font-size:28px;font-weight:800}
  .somatorio .detalhe{font-size:12px;color:var(--tinta-2)}
  .acoes{padding:16px 20px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .acoes .obs{font-size:12.5px;color:var(--tinta-2);margin-left:auto}

  .modal{display:none;position:fixed;inset:0;background:rgba(16,32,46,.55);z-index:95;
    align-items:center;justify-content:center;padding:20px}
  .modal.ver{display:flex}
  .caixa{background:#fff;border-radius:10px;max-width:620px;width:100%;max-height:88vh;overflow:auto}
  .caixa .corpo{padding:18px 20px;display:flex;flex-direction:column;gap:14px}
  .caixa .corpo p{margin:0;font-size:13px;color:var(--tinta-2)}
  .msg.bom{color:var(--ok);font-weight:600}
  .caixa .pe{padding:14px 20px;border-top:1px solid var(--linha);display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
  code{background:#f0f4f6;padding:2px 6px;border-radius:4px;font-size:12px;word-break:break-all}
  ol{margin:0;padding-left:20px;font-size:13px;color:var(--tinta-2);line-height:1.7}

  @media(max-width:980px){
    .kpis{grid-template-columns:repeat(2,1fr)}
    .grid2{grid-template-columns:1fr}
    .campos{grid-template-columns:repeat(2,1fr)}
    .campo.total{grid-column:span 2}
  }
  @media(max-width:560px){
    .campos{grid-template-columns:1fr}
    .campo.largo,.campo.total{grid-column:span 1}
    .kpis{grid-template-columns:1fr}
  }
</style>
</head>
<body>

<!-- =================== LOGIN =================== -->
<div id="login">
  <div class="cartao">
    <div class="logo">TRANSCCEMA<em>.</em></div>
    <div class="sub">Faturamento por cliente <b style="color:#0f766e">v7</b></div>

    <div class="linha-campo">
      <label for="l_usuario">Usuário</label>
      <input id="l_usuario" autocomplete="username" autocapitalize="none" spellcheck="false">
    </div>
    <div class="linha-campo">
      <label for="l_senha">Senha</label>
      <input id="l_senha" type="password" autocomplete="current-password">
    </div>

    <button id="btnEntrar">Entrar</button>
    <div class="aviso" id="avisoLogin"></div>

    <div class="rodape">
      O acesso é conferido no servidor da planilha. O usuário de visualização vê os
      números mas não consegue lançar nem apagar nada.<br>
      <a id="linkConexao">Configurar a conexão com a planilha</a>
    </div>
  </div>
</div>

<!-- =================== APP =================== -->
<div id="app" class="escondido">

<header>
  <div class="marca">TRANSCCEMA <span>· Faturamento por cliente · v7</span></div>
  <div class="status">
    <span class="cracha" id="cracha"></span>
    <span><i class="bolinha" id="bolinha"></i> <span id="txtStatus">iniciando…</span></span>
    <button class="ico" id="btnAtualizar">Atualizar</button>
    <button class="ico" id="btnConexao">Conexão</button>
    <button class="ico" id="btnSair">Sair</button>
  </div>
</header>

<nav>
  <button aria-selected="true" data-aba="painel">Painel</button>
  <button aria-selected="false" data-aba="lancar" id="navLancar">Lançar frete</button>
  <button aria-selected="false" data-aba="fretes">Fretes lançados</button>
</nav>

<div class="banner ruim" id="bannerErro">
  <div><b id="tituloErro">Não foi possível concluir</b><span id="msgErro"></span></div>
  <button id="fecharErro">Tentar de novo</button>
</div>
<div class="banner bom" id="bannerOk">
  <div><b id="msgOk"></b></div>
  <button id="fecharOk">Fechar</button>
</div>

<main>

<!-- =================== PAINEL =================== -->
<section class="aba ativa" id="aba-painel">
  <div class="tela">
    <div class="chips">
      <span class="rot">Faturar por</span>
      <span id="chipsBase"></span>
      <span class="sep"></span>
      <span class="rot">Ano</span>
      <span id="chipsAno"></span>
      <span class="sep"></span>
      <span class="rot">Mês</span>
      <span id="chipsMes"></span>
    </div>
    <div class="chips">
      <span class="rot">Ver por</span>
      <span id="chipsAgrupar"></span>
      <span class="sep"></span>
      <span id="chipsTipo"></span>
      <span class="sep"></span>
      <select id="filtroCliente" title="Filtrar por cliente"></select>
    </div>

    <div class="kpis">
      <div class="kpi">
        <div class="lab">Faturamento total</div>
        <div class="val" id="kpiTotal">—</div>
        <div class="sub" id="kpiTotalSub">—</div>
      </div>
      <div class="kpi">
        <div class="lab">Fretes de ida</div>
        <div class="val" id="kpiIda" style="color:var(--ida)">—</div>
        <div class="sub" id="kpiIdaSub">—</div>
      </div>
      <div class="kpi">
        <div class="lab">Fretes de retorno</div>
        <div class="val" id="kpiVolta" style="color:var(--volta)">—</div>
        <div class="sub" id="kpiVoltaSub">—</div>
      </div>
      <div class="kpi">
        <div class="lab">Ticket médio por frete</div>
        <div class="val" id="kpiTicket">—</div>
        <div class="sub" id="kpiTicketSub">—</div>
      </div>
    </div>

    <div class="grid2">
      <div class="bloco">
        <h3 id="tituloGrafico">Faturamento por período</h3>
        <div class="barras" id="grafico"></div>
        <div class="legenda">
          <span><i class="pt" style="background:var(--ida)"></i>Ida</span>
          <span><i class="pt" style="background:var(--volta)"></i>Retorno</span>
          <span style="margin-left:auto" id="legendaGrafico"></span>
        </div>
      </div>
      <div class="bloco">
        <h3 id="tituloRanking">Ranking de clientes — ida + retorno somados</h3>
        <div class="rank" id="ranking"></div>
        <div class="legenda"><span id="legendaRank"></span></div>
      </div>
    </div>
  </div>

  <div class="tela">
    <div class="cab">
      <h2 id="tituloTabelaCliente">Faturamento por cliente</h2>
      <span class="info" id="infoTabelaCliente"></span>
    </div>
    <div class="rolagem">
      <table>
        <thead><tr>
          <th>Cliente</th>
          <th class="v">Fretes ida</th><th class="v">R$ ida</th>
          <th class="v">Fretes retorno</th><th class="v">R$ retorno</th>
          <th class="v">Total de fretes</th><th class="v">Faturamento total</th>
          <th class="v">Ticket médio</th><th class="v">% da carteira</th>
        </tr></thead>
        <tbody id="corpoClientes"></tbody>
      </table>
    </div>
  </div>

  <div class="tela">
    <div class="cab"><h2>Últimos fretes lançados</h2><span class="info" id="infoUltimos"></span></div>
    <div class="aviso-pendente" id="avisoPendentes" style="display:none"></div>
    <div class="rolagem"><table>
      <thead><tr>
        <th>Data</th><th>Tipo</th><th>Cliente origem</th><th>Cliente destino</th>
        <th>Origem → Destino</th><th>CTRC</th><th>Cavalo</th><th>Motorista</th><th class="v">Total</th>
      </tr></thead>
      <tbody id="corpoUltimos"></tbody>
    </table></div>
  </div>
</section>

<!-- =================== LANÇAR =================== -->
<section class="aba" id="aba-lancar">
  <div class="tela">
    <div class="cab">
      <h2 id="tituloForm">Lançar novo frete</h2>
      <span class="info">Os mesmos campos da planilha RE91. O total é somado sozinho.</span>
    </div>
    <form id="formFrete" autocomplete="off">
      <input type="hidden" id="f_id">

      <div class="secao">
        <h3>Clientes e viagem</h3>
        <div class="campos">
          <div class="campo">
            <label for="f_tipo">Tipo de frete *</label>
            <select id="f_tipo"><option value="IDA">IDA</option><option value="RETORNO">RETORNO</option></select>
            <span class="msg"></span>
          </div>
          <div class="campo">
            <label for="f_programacao">Programação carregamento *</label>
            <input type="date" id="f_programacao">
            <span class="msg" id="msg_programacao"></span>
          </div>
          <div class="campo">
            <label for="f_clienteOrigem">Cliente de origem * <span class="dica">(quem carrega e paga)</span></label>
            <input id="f_clienteOrigem" placeholder="BRIDGESTONE">
            <span class="msg" id="msg_clienteOrigem"></span>
          </div>
          <div class="campo">
            <label for="f_clienteDestino">Cliente de destino <span class="dica">(quem recebe a carga)</span></label>
            <input id="f_clienteDestino" placeholder="ALENZA">
            <span class="msg"></span>
          </div>
          <div class="campo">
            <label for="f_origem">Cidade de origem</label>
            <input id="f_origem" placeholder="CAMAÇARI">
            <span class="msg"></span>
          </div>
          <div class="campo">
            <label for="f_destino">Cidade de destino</label>
            <input id="f_destino" placeholder="CAJAMAR">
