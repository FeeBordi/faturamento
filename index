document.getElementById('btnEntrar').addEventListener('click', entrar);
['l_usuario','l_senha'].forEach(function(id){
  document.getElementById(id).addEventListener('keydown', function(ev){
    if (ev.key === 'Enter') entrar();
  });
});
document.getElementById('btnSair').addEventListener('click', sair);

document.querySelectorAll('nav button').forEach(function(b){
  b.addEventListener('click', function(){ trocarAba(b.dataset.aba); });
});

document.getElementById('filtroCliente').addEventListener('change', function(){
  estado.filtros.cliente = this.value;
  desenharTudo();
});
document.getElementById('filtroMesLista').addEventListener('change', function(){
  estado.lista.mes = this.value;
  desenharListaFretes();
});
document.getElementById('busca').addEventListener('input', function(){
  estado.lista.busca = this.value;
  desenharListaFretes();
});
document.getElementById('btnCsv').addEventListener('click', baixarCsv);

document.getElementById('cabecalhoFretes').addEventListener('click', function(ev){
  var alvo = ev.target;
  if (!alvo || !alvo.getAttribute) return;

  if (alvo.id === 'btnLimparFiltros') {
    estado.lista.filtros = {};
    estado.lista.pendentes = false;
    estado.lista.busca = '';
    estado.lista.tipo = 'todos';
    estado.lista.mes = 'todos';
    document.getElementById('busca').value = '';
    document.getElementById('filtroMesLista').value = 'todos';
    montarChips();
    desenharListaFretes();
    return;
  }

  var titulo = alvo.closest ? alvo.closest('[data-ordenar]') : null;
  if (titulo) {
    var campo = titulo.getAttribute('data-ordenar');
    if (estado.lista.ordemCampo === campo) estado.lista.ordemDesc = !estado.lista.ordemDesc;
    else { estado.lista.ordemCampo = campo; estado.lista.ordemDesc = false; }
    desenharListaFretes();
  }
});

document.getElementById('cabecalhoFretes').addEventListener('change', function(ev){
  var campo = ev.target.getAttribute && ev.target.getAttribute('data-filtro');
  if (!campo) return;
  estado.lista.filtros[campo] = ev.target.value;
  desenharListaFretes();
});

/* Filtro digitado: espera a pessoa parar de digitar antes de redesenhar. */
var relogioFiltro = null;
document.getElementById('cabecalhoFretes').addEventListener('input', function(ev){
  var campo = ev.target.getAttribute && ev.target.getAttribute('data-filtro');
  if (!campo || ev.target.tagName === 'SELECT') return;

  estado.lista.filtros[campo] = ev.target.value;
  var posicao = ev.target.selectionStart;

  window.clearTimeout(relogioFiltro);
  relogioFiltro = window.setTimeout(function(){
    desenharListaFretes();
    var voltou = document.querySelector('[data-filtro="' + campo + '"]');
    if (voltou && voltou.focus) {
      voltou.focus();
      try { voltou.setSelectionRange(posicao, posicao); } catch(err){}
    }
  }, 300);
});
document.getElementById('avisoPendentes').addEventListener('click', function(){
  estado.lista.pendentes = true;
  estado.lista.busca = '';
  estado.lista.tipo = 'todos';
  estado.lista.mes = 'todos';
  document.getElementById('busca').value = '';
  document.getElementById('filtroMesLista').value = 'todos';
  montarChips();
  desenharListaFretes();
  trocarAba('fretes');
  window.scrollTo({top:0, behavior:'smooth'});
});
document.getElementById('fecharErro').addEventListener('click', function(){ limparErro(); baixar(true); });
document.getElementById('fecharOk').addEventListener('click', function(){
  document.getElementById('bannerOk').classList.remove('ver');
});
document.getElementById('btnAtualizar').addEventListener('click', function(){ baixar(true); });

document.querySelectorAll('[data-valor]').forEach(function(i){
  i.addEventListener('input', totalForm);
  i.addEventListener('blur', function(){
    if (this.value.trim()) this.value = numero(paraNumero(this.value));
    totalForm();
  });
});

document.getElementById('btnLimpar').addEventListener('click', limparForm);
document.getElementById('btnCancelarEdicao').addEventListener('click', limparForm);

document.getElementById('formFrete').addEventListener('submit', function(ev){
  ev.preventDefault();
  limparErro();

  if (estado.perfil !== 'master') {
    erro('Seu usuário é de visualização e não pode gravar.', 'Sem permissão');
    return;
  }

  var problemas = validarForm();
  if (problemas.length) {
    erro('Confira os campos marcados: ' + problemas.join(', ') + '.', 'Faltam dados');
    return;
  }

  var registro = lerForm();
  var editando = !!estado.editando;
  var botao = document.getElementById('btnSalvar');
  botao.disabled = true;
  botao.textContent = editando ? 'Salvando…' : 'Gravando…';

  chamar({acao: editando ? 'atualizar' : 'incluir', dados: JSON.stringify(registro), token:estado.token},
         editando ? 'A alteração' : 'A gravação')
    .then(function(resposta){
      sucesso(resposta.mensagem || 'Frete gravado.');
      limparForm();
      return baixar(true);
    })
    .catch(function(err){
      erro(err.message + ' Os campos continuam preenchidos — corrija e tente de novo.', 'Não foi possível gravar');
    })
    .then(function(){
      botao.disabled = false;
      botao.textContent = estado.editando ? 'Salvar alterações' : 'Gravar frete na planilha';
    });
});

document.getElementById('corpoFretes').addEventListener('click', function(ev){
  var alvo = ev.target;
  if (!alvo || !alvo.getAttribute) return;

  var idEditar = alvo.getAttribute('data-editar');
  if (idEditar) {
    var achou = null;
    estado.fretes.forEach(function(f){ if (String(f[COL.id]) === idEditar) achou = f; });
    if (!achou) { erro('O frete ' + idEditar + ' não está mais na lista. Atualize a tela.', 'Frete não encontrado'); return; }
    preencherForm(achou);
    return;
  }

  var idExcluir = alvo.getAttribute('data-excluir');
  if (idExcluir) {
    if (!window.confirm('Apagar o frete ' + idExcluir + ' da planilha? Isso não tem volta.')) return;
    limparErro();
    alvo.disabled = true;
    alvo.textContent = 'Apagando…';
    chamar({acao:'excluir', id:idExcluir, token:estado.token}, 'A exclusão')
      .then(function(resposta){
        sucesso(resposta.mensagem || 'Frete apagado.');
        return baixar(true);
      })
      .catch(function(err){
        erro(err.message, 'Não foi possível apagar');
        alvo.disabled = false;
        alvo.textContent = 'Excluir';
      });
  }
});

/* ---- modal de conexão ---- */
function abrirModal(){
  document.getElementById('urlScript').value = estado.url;
  document.getElementById('msgUrl').textContent = '';
  document.getElementById('modalConexao').classList.add('ver');
}
function fecharModal(){ document.getElementById('modalConexao').classList.remove('ver'); }

document.getElementById('btnConexao').addEventListener('click', abrirModal);
document.getElementById('linkConexao').addEventListener('click', abrirModal);
document.getElementById('btnFecharModal').addEventListener('click', fecharModal);
document.getElementById('modalConexao').addEventListener('click', function(ev){
  if (ev.target === this) fecharModal();
});

function urlValida(u){
  return /^https:\/\/script\.google\.com\/macros\/s\/[A-Za-z0-9_-]+\/exec$/.test(String(u).trim());
}

document.getElementById('btnSalvarUrl').addEventListener('click', function(){
  var u = document.getElementById('urlScript').value.trim();
  var msg = document.getElementById('msgUrl');
  if (!u) { msg.textContent = 'Cole a URL do aplicativo da web.'; return; }
  if (!urlValida(u)) {
    msg.textContent = 'A URL precisa começar com https://script.google.com/macros/s/ e terminar em /exec';
    return;
  }
  estado.url = u;
  guardar('faturamento_url', u);
  fecharModal();
  document.getElementById('avisoLogin').textContent = 'Conexão salva. Pode entrar.';
  if (estado.token) baixar(true);
});

document.getElementById('btnTestar').addEventListener('click', function(){
  var u = document.getElementById('urlScript').value.trim();
  var msg = document.getElementById('msgUrl');
  if (!urlValida(u)) { msg.textContent = 'URL fora do formato esperado.'; return; }
  msg.className = 'msg';
  msg.textContent = 'Testando…';

  var guardada = estado.url;
  estado.url = u;
  chamar({acao:'ping'}, 'O teste', 40)
    .then(function(d){
      var abas = (d.abas && d.abas.length) ? ' Abas encontradas: ' + d.abas.join(' e ') + '.' : '';
      msg.className = 'msg bom';
      msg.textContent = 'Conexão respondendo.' + abas;
      guardar('faturamento_url', u);
    })
    .catch(function(err){ msg.className = 'msg'; msg.textContent = 'Sem resposta: ' + err.message; })
    .then(function(){ if (!estado.url) estado.url = guardada; });
});

/* ===================== INÍCIO ===================== */
function iniciar(){
  estado.url    = ler('faturamento_url') || URL_PADRAO;
  estado.token  = ler('faturamento_token') || '';
  estado.perfil = ler('faturamento_perfil') || '';
  estado.nome   = ler('faturamento_nome') || '';

  var cache = lerCache();
  if (cache && cache.length) estado.fretes = cache;
  desenharTudo();

  if (!estado.url) {
    mostrarLogin('Configure a conexão com a planilha antes de entrar.');
    abrirModal();
    return;
  }
  if (!estado.token) { mostrarLogin(''); return; }

  mostrarApp();
  status('reconectando…','carregando');
  baixar(false);
}

window.addEventListener('error', function(ev){
  erro('Erro inesperado na tela: ' + (ev.message || 'sem detalhe') + '. Recarregue a página.', 'Falha no sistema');
});

iniciar();
})();
