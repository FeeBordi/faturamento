function chip(texto, ligado, aoClicar){
  var b = document.createElement('button');
  b.type = 'button';
  b.className = 'chip' + (ligado ? ' on' : '');
  b.textContent = texto;
  b.addEventListener('click', aoClicar);
  return b;
}

function montarChips(){
  var cBase = document.getElementById('chipsBase');
  cBase.innerHTML = '';
  [['origem','Cliente de origem'],['destino','Cliente de destino']].forEach(function(par){
    cBase.appendChild(chip(par[1], estado.filtros.base === par[0], function(){
      estado.filtros.base = par[0];
      estado.filtros.cliente = 'todos';
      desenharTudo();
    }));
  });

  var cAno = document.getElementById('chipsAno');
  cAno.innerHTML = '';
  cAno.appendChild(chip('Todos', estado.filtros.ano === 'todos', function(){ estado.filtros.ano='todos'; desenharTudo(); }));
  anosDisponiveis().forEach(function(a){
    cAno.appendChild(chip(a, String(estado.filtros.ano) === a, function(){ estado.filtros.ano=a; desenharTudo(); }));
  });

  var cMes = document.getElementById('chipsMes');
  cMes.innerHTML = '';
  cMes.appendChild(chip('Todos', estado.filtros.mes === 'todos', function(){ estado.filtros.mes='todos'; desenharTudo(); }));
  MESES.forEach(function(m,i){
    cMes.appendChild(chip(m, String(estado.filtros.mes) === String(i+1), function(){ estado.filtros.mes=i+1; desenharTudo(); }));
  });

  var cAgr = document.getElementById('chipsAgrupar');
  cAgr.innerHTML = '';
  [['dia','Dia'],['semana','Semana'],['mes','Mês'],['ano','Ano']].forEach(function(par){
    cAgr.appendChild(chip(par[1], estado.filtros.agrupar === par[0], function(){ estado.filtros.agrupar=par[0]; desenharTudo(); }));
  });

  var cTipo = document.getElementById('chipsTipo');
  cTipo.innerHTML = '';
  [['todos','Ida + retorno'],['IDA','Só ida'],['RETORNO','Só retorno']].forEach(function(par){
    cTipo.appendChild(chip(par[1], estado.filtros.tipo === par[0], function(){ estado.filtros.tipo=par[0]; desenharTudo(); }));
  });

  var cPend = document.getElementById('chipsPendentes');
  cPend.innerHTML = '';
  cPend.appendChild(chip('Só pendentes de valor', estado.lista.pendentes, function(){
    estado.lista.pendentes = !estado.lista.pendentes;
    desenharListaFretes();
    montarChips();
  }));

  var cTipoL = document.getElementById('chipsTipoLista');
  cTipoL.innerHTML = '';
  [['todos','Todos'],['IDA','Ida'],['RETORNO','Retorno']].forEach(function(par){
    cTipoL.appendChild(chip(par[1], estado.lista.tipo === par[0], function(){
      estado.lista.tipo = par[0]; desenharListaFretes(); montarChips();
    }));
  });
}

