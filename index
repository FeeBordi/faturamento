/* Cada coluna da lista: onde busca o dado, que tipo de filtro usa e como ordena. */
var COLUNAS_LISTA = [
  { campo:'id',             rotulo:'ID',             col:'id',             filtro:'texto',  ordem:'texto' },
  { campo:'programacao',    rotulo:'Data',           col:'programacao',    filtro:'texto',  ordem:'data'  },
  { campo:'tipo',           rotulo:'Tipo',           col:'tipo',           filtro:'select', ordem:'texto' },
  { campo:'clienteOrigem',  rotulo:'Cliente origem', col:'clienteOrigem',  filtro:'select', ordem:'texto' },
  { campo:'clienteDestino', rotulo:'Cliente destino',col:'clienteDestino', filtro:'select', ordem:'texto' },
  { campo:'origem',         rotulo:'Cidade origem',  col:'origem',         filtro:'select', ordem:'texto' },
  { campo:'destino',        rotulo:'Cidade destino', col:'destino',        filtro:'select', ordem:'texto' },
  { campo:'ctrc',           rotulo:'CTRC',           col:'ctrc',           filtro:'texto',  ordem:'texto' },
  { campo:'notas',          rotulo:'Notas',          col:'notas',          filtro:'texto',  ordem:'texto' },
  { campo:'cavalo',         rotulo:'Cavalo',         col:'cavalo',         filtro:'select', ordem:'texto' },
  { campo:'carreta',        rotulo:'Carreta',        col:'carreta',        filtro:'select', ordem:'texto' },
  { campo:'motorista',      rotulo:'Motorista',      col:'motorista',      filtro:'select', ordem:'texto' },
  { campo:'frete',          rotulo:'Frete',          col:'frete',          filtro:'nenhum', ordem:'numero', dir:true },
  { campo:'pedagio',        rotulo:'Pedágio',        col:'pedagio',        filtro:'nenhum', ordem:'numero', dir:true },
  { campo:'advalorem',      rotulo:'Ad-val.',        col:'advalorem',      filtro:'nenhum', ordem:'numero', dir:true },
  { campo:'despesas',       rotulo:'Despesas',       col:'despesas',       filtro:'nenhum', ordem:'numero', dir:true },
  { campo:'icms',           rotulo:'ICMS',           col:'icms',           filtro:'nenhum', ordem:'numero', dir:true },
  { campo:'total',          rotulo:'Total',          col:'total',          filtro:'nenhum', ordem:'numero', dir:true },
  { campo:'agenda',         rotulo:'Agenda',         col:'agenda',         filtro:'texto',  ordem:'data'  },
  { campo:'envelope',       rotulo:'Envelope',       col:'envelope',       filtro:'texto',  ordem:'texto' },
  { campo:'alteradoPor',    rotulo:'Alterado por',   col:'alteradoPor',    filtro:'select', ordem:'texto' },
  { campo:'atualizado',     rotulo:'Quando',         col:'atualizado',     filtro:'nenhum', ordem:'texto' }
];

function valorDe(f, campo){
  var def = null;
  for (var i = 0; i < COLUNAS_LISTA.length; i++) if (COLUNAS_LISTA[i].campo === campo) def = COLUNAS_LISTA[i];
  if (!def) return '';
  var v = f[COL[def.col]];
  return (v === null || v === undefined) ? '' : v;
}

/* Aplica os filtros de coluna, a busca livre e os chips de cima. */
function fretesDaLista(){
  var busca = estado.lista.busca.trim().toLowerCase();
  var filtros = estado.lista.filtros;

  var dados = estado.fretes.filter(function(f){
    if (estado.lista.tipo !== 'todos' && f[COL.tipo] !== estado.lista.tipo) return false;
    if (estado.lista.pendentes && (Number(f[COL.total]) || 0) > 0) return false;

    if (estado.lista.mes !== 'todos') {
      var p = partes(f[COL.programacao]);
      if (!p || String(p.mes) !== String(estado.lista.mes)) return false;
    }

    for (var campo in filtros) {
      var procurado = String(filtros[campo] || '').trim();
      if (!procurado) continue;
      var atual = String(valorDe(f, campo)).toLowerCase();
      if (atual.indexOf(procurado.toLowerCase()) === -1) return false;
    }

    if (busca) {
      var alvo = [f[COL.clienteOrigem],f[COL.clienteDestino],f[COL.ctrc],f[COL.notas],f[COL.cavalo],
                  f[COL.carreta],f[COL.motorista],f[COL.origem],f[COL.destino],f[COL.senhas],
                  f[COL.id],f[COL.envelope],f[COL.alteradoPor]].join(' ').toLowerCase();
      if (alvo.indexOf(busca) === -1) return false;
    }
    return true;
  });

  return ordenar(dados);
}

function ordenar(dados){
  var campo = estado.lista.ordemCampo || 'programacao';
  var desc  = estado.lista.ordemDesc !== false;

  var def = null;
  for (var i = 0; i < COLUNAS_LISTA.length; i++) if (COLUNAS_LISTA[i].campo === campo) def = COLUNAS_LISTA[i];
  var modo = def ? def.ordem : 'texto';

  return dados.slice().sort(function(a,b){
    var va = valorDe(a, campo), vb = valorDe(b, campo), r = 0;

    if (modo === 'numero') {
      r = (Number(va)||0) - (Number(vb)||0);
    } else if (modo === 'data') {
      var pa = partes(va), pb = partes(vb);
      var ia = pa ? pa.iso : '', ib = pb ? pb.iso : '';
      r = ia < ib ? -1 : (ia > ib ? 1 : 0);
    } else {
      r = String(va).localeCompare(String(vb), 'pt-BR');
    }
    if (r === 0) r = String(a[COL.id]).localeCompare(String(b[COL.id]));
    return desc ? -r : r;
  });
}

/* Monta o cabeçalho: linha de títulos clicáveis e linha de filtros. */
function desenharCabecalhoLista(){
  var alvo = document.getElementById('cabecalhoFretes');
  var filtros = estado.lista.filtros;

  var titulos = COLUNAS_LISTA.map(function(c){
    var ativa = estado.lista.ordemCampo === c.campo;
    var seta = ativa ? ('<span class="seta">' + (estado.lista.ordemDesc !== false ? '▼' : '▲') + '</span>') : '';
    return '<th class="ordenavel' + (c.dir ? ' v' : '') + '" data-ordenar="' + c.campo + '" ' +
           'title="Clique para ordenar">' + escapar(c.rotulo) + seta + '</th>';
  }).join('') + '<th></th>';

  var linhaFiltros = COLUNAS_LISTA.map(function(c){
    if (c.filtro === 'nenhum') return '<th></th>';
    var atual = filtros[c.campo] || '';
    var ligado = atual ? ' ativo' : '';

    if (c.filtro === 'select') {
      var vistos = {};
      estado.fretes.forEach(function(f){
        var v = String(valorDe(f, c.campo) || '').trim();
        if (v) vistos[v] = true;
      });
      var opcoes = Object.keys(vistos).sort(function(a,b){ return a.localeCompare(b,'pt-BR'); });
      return '<th><select class="filtro-coluna' + ligado + '" data-filtro="' + c.campo + '">' +
             '<option value="">Todos</option>' +
             opcoes.map(function(o){
               return '<option value="' + escapar(o) + '"' + (o === atual ? ' selected' : '') + '>' +
                      escapar(o) + '</option>';
             }).join('') + '</select></th>';
    }
    return '<th><input class="filtro-coluna' + ligado + '" data-filtro="' + c.campo +
           '" value="' + escapar(atual) + '" placeholder="filtrar"></th>';
  }).join('') + '<th><button class="limpar-filtros" id="btnLimparFiltros">Limpar</button></th>';

  alvo.innerHTML = '<tr>' + titulos + '</tr><tr class="filtros">' + linhaFiltros + '</tr>';
}

function desenharListaFretes(){
  desenharCabecalhoLista();

  var master = estado.perfil === 'master';
  var dados = fretesDaLista();
  var corpo = document.getElementById('corpoFretes');
  var mostrar = dados.slice(0, 400);
  var colunas = COLUNAS_LISTA.length + 1;

  if (!dados.length) {
